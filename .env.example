# ─── Web (apps/web) — build-time ──────────────────────────────────────────
# Base URL of the agent API. Leave empty to call same-origin /api
# (the dev proxy in vite.config.ts, or the Vercel rewrite in production).
VITE_API_URL=

# ─── Server (apps/server) ─────────────────────────────────────────────────
PORT=8787
GOLD_SYMBOL=GC=F            # COMEX gold futures (front month)
DXY_SYMBOL=DX-Y.NYB         # ICE US Dollar Index (evidence signal)
TNX_SYMBOL=^TNX             # CBOE 10-Year Treasury Yield (evidence signal)
WEB_ORIGIN=*                # CORS allow-list; comma-separated origins in prod
STATE_FILE=.data/agent-state.json
SNAPSHOT_TTL_MS=60000       # how long live data is cached before refetch
HISTORY_DAYS=400

# Durable persistence (optional, recommended for prod). When set, add a
# Postgres store adapter implementing the Store interface and select it.
# DATABASE_URL=postgres://user:pass@host/db
