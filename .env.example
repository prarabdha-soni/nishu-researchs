# ─── Web (Vercel) ─────────────────────────────────────────────────────────────
# Leave empty in dev (vite.config.ts proxy handles /api/*).
# Set to your Render URL in Vercel's env settings for production.
VITE_API_URL=

# ─── API (Render / local) ─────────────────────────────────────────────────────
PORT=8000
WEB_ORIGIN=*                   # CORS allow-list; comma-separated origins in prod

# Market data
GOLD_SYMBOL=GC=F               # COMEX gold futures (front month)
DXY_SYMBOL=DX-Y.NYB            # ICE US Dollar Index
TNX_SYMBOL=^TNX                # CBOE 10-Year Treasury Yield
MCX_GOLD_SYMBOL=GOLDM.MCX      # MCX gold (India)
HISTORY_DAYS=400
SNAPSHOT_TTL_S=60

# ─── Phase 1 — Sourced data spine ─────────────────────────────────────────────
# FRED API key (free): https://fred.stlouisfed.org/docs/api/api_key.html
# Powers: real yields, breakeven inflation, CPI series
FRED_API_KEY=

# Database (SQLite for local, PostgreSQL/Neon for production)
# SQLite: leave unset — defaults to api/data/nishu.db
# Neon free: postgresql://user:pass@ep-xxx.neon.tech/nishu?sslmode=require
DATABASE_URL=

# Agent state (separate from the provenance DB — JSON file by default)
STATE_FILE=.data/agent-state.json

# ─── Phase 2 — Explanation engine ─────────────────────────────────────────────
# DeepSeek API key: https://platform.deepseek.com/
# Used for daily causal note generation. Falls back gracefully if unset.
DEEPSEEK_API_KEY=sk-2678dfe80add42b68d2bf5eecbb77f0f
DEEPSEEK_MODEL=deepseek-chat   # or deepseek-reasoner for deeper analysis
