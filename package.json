{
  "name": "nishu-researchs",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:web":     "npm run dev --prefix web",
    "dev:api":     "uvicorn api.main:app --reload --port 8000",
    "dev":         "concurrently -k -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "build":       "npm run build --prefix web",
    "typecheck":   "npm run typecheck --prefix web",
    "lint":        "npm run lint --prefix web",
    "install:api": "pip install -r api/requirements.txt",
    "start:api":   "uvicorn api.main:app --host 0.0.0.0 --port 8000",
    "setup":       "npm install && pip install -r api/requirements.txt"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
